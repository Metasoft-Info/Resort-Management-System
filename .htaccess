Options -Indexes

<FilesMatch "(?i)(^\.|\.sql$|\.log$|\.bak$|\.backup$|^artisan$|^composer\.(json|lock)$|^package(-lock)?\.json$|^phpunit\.xml$|^README\.md$|^DEPLOYMENT_GUIDE\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If request is already targeting /public, keep it.
    RewriteRule ^public/ - [L]

    # Serve existing files/directories from project root as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to Laravel public directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
